# Copy this file to .env and fill in real values. .env is gitignored.

# Free tier: 500 credits/month, sign up at https://the-odds-api.com. Used by
# data/pull_historical_odds.py to pull real historical player-prop lines for
# backtesting against actual market lines instead of our own proxy line -- see
# that script's docstring for the credit-budget math and setup steps.
ODDS_API_KEY=your_odds_api_key_here

# Also used by data/pull_odds_api.py (live sportsbook props for the +EV Finder) --
# live event odds cost 1 credit per market per region per game.

# Optional: AI write-ups on the +EV Finder page (models/interpreter.py). Without it
# the page shows a template summary instead. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: keep the bet log in a private GitHub repo so it survives hosted redeploys
# (dashboard/bet_store.py). Fine-grained token, only that repo, Contents: Read and write.
# Without it bets go to bet_logs/bets.csv (local disk only).
BET_LOG_GITHUB_TOKEN=
# BET_LOG_REPO=alexanderseaney-sketch/parlaymodel-bets
