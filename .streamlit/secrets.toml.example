# Copy this file to .streamlit/secrets.toml for local testing (gitignored, never commit
# real values). On Streamlit Community Cloud, set these under App settings -> Secrets
# instead of using this file. Run `streamlit run dashboard/app.py` from the repo root
# so this file is on the path Streamlit looks for secrets.

dashboard_password = "choose-a-real-password-here"

# --- Yahoo Fantasy connection (optional; the Fantasy page hides the panel without it) ---
# 1. Create an app at https://developer.yahoo.com/apps/create/
#      Application Type: Web Application
#      Redirect URI(s):  your app URL -- https://<your-app>.streamlit.app  (and/or
#                        http://localhost:8501 for local). Must match exactly.
#      API Permissions:  Fantasy Sports -> Read
# 2. Paste the Client ID / Secret below (or into Streamlit Cloud secrets).
# yahoo_client_id     = "..."
# yahoo_client_secret = "..."
# yahoo_redirect_uri  = "https://<your-app>.streamlit.app"
# 3. After the first in-app "Authorize with Yahoo", the panel prints a refresh token.
#    Add it here so the connection survives restarts (Cloud has no persistent disk):
# yahoo_refresh_token = "..."
