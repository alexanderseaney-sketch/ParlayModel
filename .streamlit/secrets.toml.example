# Copy this file to .streamlit/secrets.toml for local testing (gitignored, never commit
# real values). On Streamlit Community Cloud, set these under App settings -> Secrets
# instead of using this file. Run `streamlit run dashboard/app.py` from the repo root
# so this file is on the path Streamlit looks for secrets.

dashboard_password = "choose-a-real-password-here"

# --- Yahoo Fantasy connection (optional; the Fantasy page hides the panel without it) ---
# 1. Create an app at https://developer.yahoo.com/apps/create/
#      Redirect URI(s):  the Fantasy page URL, exactly --
#                        https://<your-app>.streamlit.app/page_fantasy
#      API Permissions:  Fantasy Sports -> Read  (if the option isn't shown, add it
#                        afterwards on the app's edit page, or the fspt-r scope is
#                        rejected as invalid_scope)
#      OAuth Client Type: Confidential (has a secret) OR Public (PKCE, no secret) --
#                        both work.
# 2. Fill these in (Streamlit Cloud: App settings -> Secrets):
# yahoo_client_id     = "..."           # the long "Client ID (Consumer Key)", not the App ID
# yahoo_client_secret = "..."           # confidential client only; omit for a public client
# yahoo_redirect_uri  = "https://<your-app>.streamlit.app/page_fantasy"
# 3. After the first in-app "Authorize with Yahoo", the panel prints a refresh token.
#    Add it here so the connection survives restarts (Cloud has no persistent disk):
# yahoo_refresh_token = "..."
# yahoo_scope         = "fspt-r"        # default; set to "" only if fspt-r is rejected
